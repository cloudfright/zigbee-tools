def write_pcap_global_header(f):
    magic = 0xa1b2c3d4
    ver_major = 2
    ver_minor = 4
    thiszone = 0
    sigfigs = 0
    snaplen = 65535
    network = 147
    f.write(struct.pack("IHHIIII", magic, ver_major, ver_minor, thiszone, sigfigs, snaplen, network))

def write_pcap_packet(f, pkt_bytes, ts=None):
    # pcap per-packet header: ts_sec, ts_usec, incl_len, orig_len (all little-endian)
    if ts is None:
        t = time.time()
    else:
        t = ts
    ts_sec = int(t)
    ts_usec = int((t - ts_sec) * 1e6)
    incl_len = len(pkt_bytes)
    orig_len = incl_len
    f.write(struct.pack("<IIII", ts_sec, ts_usec, incl_len, orig_len))
    f.write(pkt_bytes)


# -----------------------
# Packet → ZEP converter
# -----------------------

def make_zep_hdr(payload, channel, lqi, rssi):

    # zep v2 header, type 1 
    # Preamble        - 2 bytes
    # Version         - 1 byte
    # Type            - 1 byte
    # Channel ID      - 1 byte
    # Device ID       - 2 bytes
    # CRC/LQI Mode    - 1 bytes
    # LQI Val         - 1 byte
    # NTP Timestamp   - 8 bytes
    # Sequence        - 4 bytes 
    # Reserved        - 10 bytes 
    # Length          - 1 byte

    deviceId = 1
    lqiMode = False

    # NTP timestamp: seconds since 1900-01-01 + fractional seconds
    NTP_EPOCH_OFFSET = 2208988800  # seconds between 1900 and 1970
    current_time = time.time()
    ntp_seconds = int(current_time) + NTP_EPOCH_OFFSET
    ntp_fraction = int((current_time % 1.0) * (2**32))
    ntp_timestamp = (ntp_seconds << 32) | ntp_fraction

    # checksum will be attached to the end of the payload 
    # In Wireshark, set Preferences/Protocols/IEEE 802.15.4 FCS format to 'TI CC24xx metadata'
    checksum = struct.pack(">bB", rssi, 0x80 | ((lqi>>1) & 0x7F))

    #  * First byte: RSSI value as a signed 8 bits integer (range -128 to 127)
    #  * Second byte:
    #      - the most significant bit is set to 1 of the CRC of the frame is correct
    #      - the 7 least significant bits contain the LQI value as a unsigned 7 bits integer (range 0 to 127)

    zep_hdr = struct.pack(">2sBBBHBBQIxxxxxxxxxxB",
                          b"EX",             
                          2,                
                          1,   
                          channel & 0xFF,            
                          deviceId,
                          lqiMode,  
                          lqi,               
                          ntp_timestamp,
                          seq_num,
                          (len(payload) + len(checksum)) & 0xFFFF,
                          )
    
    return zep_hdr + payload + checksum


# -----------------------
# Capture loop
# -----------------------

def run_capture(serial_port, fifo, channel, baud):

    try:
        ser = serial.Serial(serial_port, baudrate=baud, timeout=0.5)

        # set Zigbee channel to listen to
        ser.write(bytes('{"C":', 'utf-8') + bytes(str(channel), 'utf-8') + bytes('}\r\n', 'utf-8'))
        time.sleep(0.1)
     
    except Exception as e:
        sys.stderr.write(f"ERROR: Cannot open serial port: {e}\n")
        sys.exit(1)

    try:
        global seq_num
        with open(fifo, "wb", buffering=0) as fp:
            print("")
            write_pcap_global_header(fp)

            while True:

                # read in a JSON frame 
                data = ser.readline().decode('utf-8', errors='strict').strip()

                try:
                    json_obj = json.loads(data)
                    length      = json_obj.get('L', 0)       # length
                    lqi         = json_obj.get('Q', 0)          # LQI
                    rssi        = json_obj.get('R', 0)         # RSSI
                    chan        = json_obj.get('C', 0)         # channel
                    hexpayload  = json_obj.get('S', 0)   # payload

                    payload = bytearray.fromhex(hexpayload)
                    zep_hdr = make_zep_hdr(payload, int(chan), int(lqi), int(rssi))
                    write_pcap_packet(fp, zep_hdr)
                     
                    seq_num += 1

                except json.JSONDecodeError as e:
                    print(f'JSONDecodeError:{e}')

    except KeyboardInterrupt:
        pass
    except Exception as e:
        sys.stderr.write(f"Capture error: {e}\n")


