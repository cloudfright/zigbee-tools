        if not args.serial_port:
            sys.stderr.write("ERROR: missing --serial-port\n")
            sys.exit(1)
        run_capture(args.serial_port, args.fifo, args.channel, args.baud)

    elif args.capture:
        if args.fifo is None:
            sys.exit(1)

        try:
            print("")
        except KeyboardInterrupt:
            pass
    