    except argparse.ArgumentError as exc:
       
        sys.exit(1)

    # extcap calling sequence https://www.wireshark.org/docs/wsdg_html_chunked/ChCaptureExtcap.html

    if len(sys.argv) <= 1:
        parser.exit("No arguments given!")

    if args.extcap_interfaces and args.extcap_version:
